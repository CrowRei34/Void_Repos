# Template file for 'chatgpt'
pkgname=chatgpt
version=26.818.61809
revision=1
archs="x86_64"
hostmakedepends="binutils tar xz zstd"
depends="gtk+3 libnotify nss xdg-utils at-spi2-core libdrm mesa-dri libxcb
 glib alsa-lib at-spi2-atk atk cairo libcups dbus-libs expat libgcc
 gdk-pixbuf mesa nspr pango libstdc++ eudev-libudev libusb libX11
 libXcomposite libXdamage libXext libXfixes libxkbcommon libXrandr
 vulkan-loader xz"
short_desc="ChatGPT desktop app and Codex CLI by OpenAI"
maintainer="CrowRei34 <root@localhost>"
license="custom:Proprietary"
homepage="https://developers.openai.com/codex/app"
distfiles="https://persistent.oaistatic.com/codex-app-prod/linux/deb/pool/main/c/chatgpt/chatgpt_${version}_amd64.deb"
checksum=1bba62a6dbd2d49975c62850d8eddaad605da193557b194982225e56b1941891
nostrip=yes
nodebug=yes
noshlibprovides=yes
noverifyrdeps=yes
nopie=yes

do_extract() {
	mkdir -p "${wrksrc}"
	cd "${wrksrc}"
	ar x "${XBPS_SRCDISTDIR}/${pkgname}-${version}/chatgpt_${version}_amd64.deb"
	mkdir data
	tar -xf data.tar.* -C data
}

do_build() {
	:
}

do_install() {
	cd "${wrksrc}/data"
	vmkdir usr
	cp -a usr/. "${DESTDIR}/usr/"

	chmod 0644 "${DESTDIR}/usr/share/applications/chatgpt.desktop"
	chmod 0644 "${DESTDIR}/usr/share/pixmaps/chatgpt.png"

	if [ -x "${DESTDIR}/usr/lib/chatgpt/resources/codex" ]; then
		ln -sf /usr/lib/chatgpt/resources/codex "${DESTDIR}/usr/bin/codex"
	fi
	if [ -x "${DESTDIR}/usr/lib/chatgpt/resources/codex-code-mode-host" ]; then
		ln -sf /usr/lib/chatgpt/resources/codex-code-mode-host \
			"${DESTDIR}/usr/bin/codex-code-mode-host"
	fi
	if [ -f usr/share/doc/chatgpt/copyright ]; then
		vlicense usr/share/doc/chatgpt/copyright
	fi
}
