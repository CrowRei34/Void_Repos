# Template file for 'parabolic-bin'
pkgname=parabolic-bin
version=2026.5.3
revision=1
archs="x86_64"

build_style=fetch
hostmakedepends="squashfs-tools"
nopie=yes
short_desc="GTK frontend for yt-dlp"
maintainer="CrowRei34 <root@localhost>"
license="MIT"
homepage="https://github.com/rockman6554/Parabolic"

distfiles="https://github.com/rockman6554/Parabolic/releases/download/v${version}/Parabolic-${version}-x86_64.AppImage"
checksum=da76d3e9e403b77c78b0c4a88dcd3d108c475cf6684795e7294d522dc9c817e6

do_install() {
	cd "$wrksrc"
	chmod 755 "./Parabolic-${version}-x86_64.AppImage"
	"./Parabolic-${version}-x86_64.AppImage" --appimage-extract >/dev/null

	local _appdir="$wrksrc/squashfs-root"
	vmkdir usr/lib/parabolic
	cp -a "${_appdir}/." "$DESTDIR/usr/lib/parabolic/"

	vmkdir usr/bin
	cat > "$DESTDIR/usr/bin/parabolic" <<'EOF'
#!/bin/sh
exec /usr/lib/parabolic/AppRun "$@"
EOF
	chmod 755 "$DESTDIR/usr/bin/parabolic"

	vinstall "${FILESDIR}/org.nickvision.tubeconverter.desktop" 644 usr/share/applications
	vlicense "${FILESDIR}/LICENSE"
}
