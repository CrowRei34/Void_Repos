# Template file for 'drift-editor'
pkgname=drift-editor
version=0.3.0
revision=1
archs="x86_64"

short_desc="Beginner-friendly open-source video editor"
maintainer="CrowRei34 <root@localhost>"
license="GPL-3.0-or-later"
homepage="https://github.com/CutWire-Studios/Drift"

hostmakedepends="tar xz"
depends="qt6-base qt6-declarative qt6-multimedia ffmpeg zstd openssl soundtouch"
nostrip=yes
nodebug=yes
nopie=yes
noshlibprovides=yes
skiprdeps="/usr/bin/drift"

distfiles="https://github.com/CrowRei34/Void_Repos/releases/download/continuous/drift-editor-x86_64.tar.xz"
checksum=0b82ab8ea07b53360bd5b8059039cf80bef9e7ac0dab70203ac03ee38514ad90

do_install() {
	local _src="${XBPS_SRCDISTDIR}/${pkgname}-${version}/drift-editor-x86_64.tar.xz"
	tar -xJf "${_src}" -C "${DESTDIR}"
	mkdir -p "${DESTDIR}/usr/lib/drift"
	mv "${DESTDIR}/usr/bin/drift" "${DESTDIR}/usr/lib/drift/drift-bin"
	vbin "${FILESDIR}/drift-wrapper" drift
}
